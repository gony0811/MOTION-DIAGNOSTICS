<?xml version="1.0" encoding="utf-8" ?>

<hibernate-mapping xmlns = "urn:nhibernate-mapping-2.2"
   assembly = "EPLE" namespace = "EPLE.Data.Entity">
  <!--.cs 위치-->

  <class
      name="DataConfigEntity"
      table="DataConfig"
      dynamic-update="true"
      dynamic-insert="true"
    >
    <id
        name="Id"
        column="Id"
        type="int"
        unsaved-value="null"
        >
      <generator class="identity">
        <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-Nio.xml 
                  containing the additional parameters and place it in your merge dir. 
              -->
      </generator>
    </id>


    <property
        name="Name"
        type="System.String"
        update="true"
        insert="true"
        length="255"
        >
      <column
        name="Name"
        length="64"
        index="DATA_NAME"
        not-null="true"
            />
    </property>

    <property
        name="Module"
        type="System.String"
        update="true"
        insert="true"
        column="Module"
        length="255"
        />

    <property
        name="TypeString"
        type="System.String"
        update="true"
        insert="true"
        column="Type"
        length="64"
        />

    <property
        name="DeviceName"
        type="System.String"
        update="true"
        insert="true"
        column="DeviceName"
        length="64"
        />     

    <property
        name="DirectionString"
        type="System.String"
        update="true"
        insert="true"
        column="Direction"
        length="64"
        />

    <property
        name="Command"
        type="System.String"
        update="true"
        insert="true"
        column="Command"
        length="255"
        />

    <property
        name="PollingTime"
        type="int"
        update="true"
        insert="true"
        column="PollingTime"
        />

    <property
        name="DataResetTimeout"
        type="int"
        update="true"
        insert="true"
        column="DataResetTimeout"
        />

    <property
        name="IsUse"
        type="YesNo"
        update="true"
        insert="true"
        column="IsUse"
        />

    <property
        name="Description"
        type="System.String"
        update="true"
        insert="true"
        column="description"
        length="255"
        />
    
    <property
        name="DefaultValue"
        type="System.String"
        update="true"
        insert="true"
        column="DefaultValue"
        length="255"
        />

    <property
        name="UpdateTime"
        type="System.String"
        update="true"
        insert="true"
        column="UpdateTime"
        length="255"
        />

    <!--
            To add non XDoclet property mappings, create a file named
                hibernate-properties-Secs.xml
            containing the additional properties and place it in your merge dir.
        -->

  </class>

</hibernate-mapping>