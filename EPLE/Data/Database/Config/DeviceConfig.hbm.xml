<?xml version="1.0" encoding="utf-8" ?>

<hibernate-mapping xmlns = "urn:nhibernate-mapping-2.2"
   assembly = "EPLE" namespace = "EPLE.Data.Entity">
  <!--.cs 위치-->

  <class
      name="DeviceConfigEntity"
      table="DeviceConfig"
      dynamic-update="true"
      dynamic-insert="true"
    >
    <id
        name="Id"
        column="Id"
        type="int"
        unsaved-value="null"
        >
      <generator class="identity">
        <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-Nio.xml 
                  containing the additional parameters and place it in your merge dir. 
              -->
      </generator>
    </id>


    <property
        name="DeviceName"
        type="System.String"
        update="true"
        insert="true"
        length="255"
        >
      <column
        name="DeviceName"
        length="255"
        index="DEVICE_NAME"
        not-null="true"
            />
    </property>

    <property
        name="DeviceType"
        type="System.String"
        update="true"
        insert="true"
        column="DeviceType"
        length="64"
        />

    <property
        name="InstanceName"
        type="System.String"
        update="true"
        insert="true"
        column="InstanceName"
        length="255"
        />

    <property
        name="FileName"
        type="System.String"
        update="true"
        insert="true"
        column="FileName"
        length="255"
        />

    <property
        name="IsUse"
        type="YesNo"
        update="true"
        insert="true"
        column="IsUse"
        />

    <property
        name="Args"
        type="System.String"
        update="true"
        insert="true"
        column="Args"
        length="255"
        />

    <property
        name="Description"
        type="System.String"
        update="true"
        insert="true"
        column="Description"
        length="255"
        />

    <!--
            To add non XDoclet property mappings, create a file named
                hibernate-properties-Secs.xml
            containing the additional properties and place it in your merge dir.
        -->

  </class>

</hibernate-mapping>