<?xml version="1.0" encoding="utf-8" ?>

<hibernate-mapping xmlns = "urn:nhibernate-mapping-2.2"
   assembly = "EPLE" namespace = "EPLE.Data.Entity">
  <!--.cs 위치-->

  <class
      name="MeasureConfigEntity"
      table="MeasureConfig"
      dynamic-update="true"
      dynamic-insert="true"
    >
    <id
        name="Id"
        column="Id"
        type="int"
        unsaved-value="null"
        >
      <generator class="identity">
        <!--  
                  To add non XDoclet generator parameters, create a file named 
                  hibernate-generator-params-Nio.xml 
                  containing the additional parameters and place it in your merge dir. 
              -->
      </generator>
    </id>


    <property
        name="Name"
        type="System.String"
        update="true"
        insert="true"
        length="255"
        >
      <column
        name="Name"
        length="255"
        index="MEASURE_NAME"
        not-null="true"
            />
    </property>

    <property
        name="XPos"
        type="int"
        update="true"
        insert="true"
        column="XPos"
        />

    <property
        name="YPos"
        type="int"
        update="true"
        insert="true"
        column="YPos"
        />

    <property
        name="IsMeasurePoint"
        type="YesNo"
        update="true"
        insert="true"
        column="IsMeasurePoint"
        />

    <property
        name="ErrorX"
        type="double"
        update="true"
        insert="true"
        column="ErrorX"
        />

    <property
        name="ErrorY"
        type="double"
        update="true"
        insert="true"
        column="ErrorY"
        />
    
    <property
        name="MeasureResultString"
        type="System.String"
        update="true"
        insert="true"
        column="MeasureResult"
        length="64"
        />

    <property
        name="UpdateTime"
        type="System.String"
        update="true"
        insert="true"
        column="UpdateTime"
        length="255"
        />

    <!--
            To add non XDoclet property mappings, create a file named
                hibernate-properties-Secs.xml
            containing the additional properties and place it in your merge dir.
        -->

  </class>

</hibernate-mapping>