<UserControl x:Class="MotionDiagnostics.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uc="clr-namespace:MotionDiagnostics.UserControls"
      xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
      d:DesignHeight="1000"
      d:DesignWidth="1200"
      mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <Thickness x:Key="ControlMargin">5 5 0 5</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>

        <!-- TabControl -->
    <telerik:RadTabControl BorderBrush="Gray" BorderThickness="1" Margin="{StaticResource ControlMargin}">
        <!-- 첫 번째 탭 -->
        <telerik:RadTabItem Header="Device">
            <Grid>
                <!-- RowDefinitions 추가 -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <!-- ItemsControl -->
                    <RowDefinition Height="Auto" />
                    <!-- Button -->
                </Grid.RowDefinitions>

                <!-- ItemsControl with ScrollViewer -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8">
                    <ItemsControl ItemsSource="{Binding TableViewModels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="5" Margin="8">
                                    <!-- Bind dynamic data to TableView -->
                                    <uc:TableView Width="300" Height="400" Margin="8"
                                                         DataContext="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Button in the Bottom-Right -->
                <Button Content="생성"
                            Command="{Binding CreateDeviceCommand}"
                            Grid.Row="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Padding="12,6"
                            Margin="8"
                            Background="#007ACC"
                            Foreground="White"
                            BorderBrush="#005A9E"
                            BorderThickness="1"
                            FontWeight="Bold" />
                </Grid>
            </telerik:RadTabItem>

        <!-- 두 번째 탭 -->
        <telerik:RadTabItem Header="Motion" Height="39" VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                    <ColumnDefinition Width="4*"></ColumnDefinition>
                    <ColumnDefinition Width="1*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid Margin="10" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" />
                    </Grid.RowDefinitions>


                    <StackPanel
                 Grid.Column="0" Grid.Row="0"
                 Margin="{StaticResource ControlMargin}"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Center"
                 >
                        <Label Foreground="#3498DB" Content="Axis Name"></Label>
                        <ComboBox SelectedValue="{Binding PositionStatus.PositionName, Mode=TwoWay}"
                      SelectedValuePath="Content"
                      FontSize="14"
                        Padding="5">
                            <ComboBoxItem Content="X" />
                            <ComboBoxItem Content="Y" />
                            <ComboBoxItem Content="Theta" />
                            <ComboBoxItem Content="Z1" />
                            <ComboBoxItem Content="Z2" />
                            <ComboBoxItem Content="Z3" />
                        </ComboBox>
                    </StackPanel>

                    <!-- PositionStatusControl -->
                    <Border Grid.Column="1" Grid.Row="0" Margin="5 0 0 0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
                        <uc:PositionStatusControl PositionStatus="{Binding PositionStatus}"/>
                    </Border>
                    <Grid Grid.ColumnSpan="2" Grid.Row="1" Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"></ColumnDefinition>
                            <ColumnDefinition Width="4*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Foreground="#3498DB" Content="Controls" HorizontalAlignment="Left"></Label>
                            <StackPanel VerticalAlignment="Top">
                                <Button Height="50" Margin="10">
                                    <Button.Content>
                                        <TextBlock TextAlignment="Center" Foreground="White">
                                    Alarm
                                    <LineBreak />
                                    Clear
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                                <Button Content="Enable" Height="50" Margin="10"></Button>
                                <Button Content="Diable" Height="50" Margin="10"></Button>
                                <Button Content="Home" Height="50" Margin="10"></Button>
                                <Button Content="Stop" Height="50" Margin="10"></Button>
                                <Button Content="Estop" Height="50" Margin="10"></Button>
                            </StackPanel>
                        </StackPanel>

                        <WrapPanel  Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center">
                            <uc:JogMoveControl/>
                            <uc:AbsoluteMoveControl Margin="30"></uc:AbsoluteMoveControl>
                            <uc:RelativeMoveControl Margin="30"></uc:RelativeMoveControl>
                        </WrapPanel>

                    </Grid>
                </Grid>
            </Grid>
        </telerik:RadTabItem>
        <telerik:RadTabItem Header="Stage" Height="39" VerticalAlignment="Top">
            <Grid Name="StageTabGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Label Content="Loading Position" FontSize="20" FontWeight="Bold"></Label>
                    <uc:StagePositionControl DataContext="{Binding TeachingVMMap[LOADING_T_POS]}" ></uc:StagePositionControl>
                    <uc:StagePositionControl DataContext="{Binding TeachingVMMap[LOADING_X_POS]}" ></uc:StagePositionControl>
                    <uc:StagePositionControl DataContext="{Binding TeachingVMMap[LOADING_Y_POS]}" ></uc:StagePositionControl>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="1"  HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Inspection Position TOP" FontSize="20" FontWeight="Bold"></Label>
                    <uc:StagePositionControl DataContext="{Binding TeachingVMMap[INSPECTION_X_POS_TOP]}" ></uc:StagePositionControl>
                    <uc:StagePositionControl DataContext="{Binding TeachingVMMap[INSPECTION_Y_POS_TOP]}" ></uc:StagePositionControl>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="2"  HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Inspection Position Center" FontSize="20" FontWeight="Bold"></Label>
                    <uc:StagePositionControl DataContext="{Binding TeachingVMMap[INSPECTION_X_POS_CENTER]}" ></uc:StagePositionControl>
                    <uc:StagePositionControl DataContext="{Binding TeachingVMMap[INSPECTION_Y_POS_CENTER]}" ></uc:StagePositionControl>
                </StackPanel>
                <StackPanel Grid.Column="1" Grid.Row="3"  HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Inspection Position Bottom" FontSize="20" FontWeight="Bold"></Label>
                    <uc:StagePositionControl DataContext="{Binding TeachingVMMap[INSPECTION_X_POS_BOTTOM]}" ></uc:StagePositionControl>
                    <uc:StagePositionControl DataContext="{Binding TeachingVMMap[INSPECTION_Y_POS_BOTTOM]}" ></uc:StagePositionControl>
                </StackPanel>
                <StackPanel Grid.Column="0" Grid.Row="2"  HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Inspection Position Left" FontSize="20" FontWeight="Bold"></Label>

                    <uc:StagePositionControl DataContext="{Binding TeachingVMMap[INSPECTION_X_POS_LEFT]}" ></uc:StagePositionControl>
                    <uc:StagePositionControl DataContext="{Binding TeachingVMMap[INSPECTION_Y_POS_LEFT]}" ></uc:StagePositionControl>
                </StackPanel>

                <StackPanel Grid.Column="3" Grid.Row="2"  HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Label Content="Inspection Position Right" FontSize="20" FontWeight="Bold"></Label>
                    <uc:StagePositionControl DataContext="{Binding TeachingVMMap[INSPECTION_X_POS_RIGHT]}" ></uc:StagePositionControl>
                    <uc:StagePositionControl DataContext="{Binding TeachingVMMap[INSPECTION_Y_POS_RIGHT]}" ></uc:StagePositionControl>
                </StackPanel>
            </Grid>

        </telerik:RadTabItem>

    </telerik:RadTabControl>
</UserControl>