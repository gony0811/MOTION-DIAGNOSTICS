<Window x:Class="MotionDiagnostics.Modal.MotionModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:uc="clr-namespace:MotionDiagnostics.UserControls"
             xmlns:cv="clr-namespace:MotionDiagnostics.Converters"
             mc:Ignorable="d"
             Width="1000"
            Height="600">
    <Window.Resources>
        <ResourceDictionary>
            <!-- Style 정의 -->
            <Style TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Black"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Margin" Value="10"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="20"/>
            </Style>

            <!-- Converter 정의 -->
            <cv:PitchValueConverter x:Key="PitchValueConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="4*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- Header Label with Border -->
            <Border Grid.Row="0">
                <Label Content="{Binding Name}"/>
            </Border>

            <!-- Main Grid with Borders -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!-- Labels with Borders -->
                <Border Grid.RowSpan="2" Grid.Row="0" Grid.Column="0">
                    <Label Content="Position"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="0">
                    <Label Content="Status"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="0">
                    <Label Content="Velocity"/>
                </Border>
                <Border Grid.RowSpan="2" Grid.Row="4" Grid.Column="0">
                    <Label Content="Pitch"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1">
                    <Label Content="Command Position"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="1">
                    <Label Content="Feedback Position"></Label>
                </Border>
                <Border Grid.Row="0" Grid.Column="2">
                    <TextBox x:Name="CommandPosition" Text="{Binding CommandPosition, StringFormat=F3}" TextAlignment="Center" MinWidth="70" IsReadOnly="True" VerticalContentAlignment="Center"/>
                </Border>

                <Border Grid.Row="1" Grid.Column="2">
                    <TextBox x:Name="FeedbackPosition" Text="{Binding FeedbackPosition, StringFormat=F3}" TextAlignment="Center" MinWidth="70" IsReadOnly="True" VerticalContentAlignment="Center"/>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="Alarm" ></RadioButton>
                        <RadioButton Grid.Column="1" Content="Enable"></RadioButton>
                        <RadioButton Grid.Column="2" Content="Busy"></RadioButton>
                    </Grid>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="Low" ></RadioButton>
                        <RadioButton Grid.Column="1" Content="Middle"></RadioButton>
                        <RadioButton Grid.Column="2" Content="High"></RadioButton>
                    </Grid>
                </Border>
                <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- 정해진 값 (라디오버튼) -->
                        <RadioButton Grid.Column="0" Grid.Row="0"
                     Content="100"
                     IsChecked="{Binding Pitch, Mode=TwoWay,
                                         Converter={StaticResource PitchValueConverter},
                                         ConverterParameter=100}" />
                        <RadioButton Grid.Column="1" Grid.Row="0"
                     Content="50"
                     IsChecked="{Binding Pitch, Mode=TwoWay,
                                         Converter={StaticResource PitchValueConverter},
                                         ConverterParameter=50}" />
                        <RadioButton Grid.Column="2" Grid.Row="0"
                     Content="10"
                     IsChecked="{Binding Pitch, Mode=TwoWay,
                                         Converter={StaticResource PitchValueConverter},
                                         ConverterParameter=10}" />
                        <RadioButton Grid.Column="3" Grid.Row="0"
                     Content="5"
                     IsChecked="{Binding Pitch, Mode=TwoWay,
                                         Converter={StaticResource PitchValueConverter},
                                         ConverterParameter=5}" />
                        <RadioButton Grid.Column="4" Grid.Row="0"
                     Content="1"
                     IsChecked="{Binding Pitch, Mode=TwoWay,
                                         Converter={StaticResource PitchValueConverter},
                                         ConverterParameter=1}" />

                        <RadioButton Grid.Column="0" Grid.Row="1"
                     Content="0.5"
                     IsChecked="{Binding Pitch, Mode=TwoWay,
                                         Converter={StaticResource PitchValueConverter},
                                         ConverterParameter=0.5}" />
                        <RadioButton Grid.Column="1" Grid.Row="1"
                     Content="0.1"
                     IsChecked="{Binding Pitch, Mode=TwoWay,
                                         Converter={StaticResource PitchValueConverter},
                                         ConverterParameter=0.1}" />

                        <!-- Custom용 RadioButton -->
                        <RadioButton Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="2"
                     IsChecked="{Binding Pitch, Mode=TwoWay,
                                         Converter={StaticResource PitchValueConverter},
                                         ConverterParameter=Custom}">
                            <!-- TextBox도 같은 Pitch를 바인딩하되, ConverterParameter를 달리 하여 "CustomText"로 구분 -->
                            <TextBox Width="100" Height="20"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Text="{Binding Pitch, Mode=TwoWay,
                                    Converter={StaticResource PitchValueConverter},
                                    ConverterParameter=CustomText,
                                    UpdateSourceTrigger=PropertyChanged}" />
                        </RadioButton>
                    </Grid>
                </Border>

            </Grid>
            <Border Grid.Row="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <Button Name="HomeBtn" Content="Home" Margin="8" Grid.Column="0" Grid.Row="0"></Button>
                    <Button Name="ServoBtn" Content="Servo" Margin="8" Grid.Column="0" Grid.Row="1"></Button>
                    <Button Name="ResetBtn" Content="Reset" Margin="8" Grid.Column="1" Grid.Row="0"></Button>
                    <Button Name="Stop" Content="Stop" Margin="8" Grid.Column="1" Grid.Row="1" Background="Red" Foreground="White"></Button>

                    <CheckBox Margin="10" Content="Pitch" Grid.Column="2" Grid.Row="0" Grid.ColumnSpan="2" VerticalContentAlignment="Center"/>

                    <Button x:Name="jib1stAxisDirectionUp" Grid.Column="4" Grid.Row="0" FontSize="14" Content="&#x25B2;"/>
                    <Button x:Name="jib1stAxisDirectionDown" Grid.Column="4" Grid.Row="1" FontSize="14" Content="&#x25BC;"/>
                    <Button x:Name="jib1stAxisDirectionLeft" Grid.Column="3" Grid.Row="1" FontSize="14" Content="&#x25C0;"/>
                    <Button x:Name="jib1stAxisDirectionRight" Grid.Column="5" Grid.Row="1" FontSize="14" Content="&#x25B6;"/>
                </Grid>
            </Border>
        </Grid>
        <!--Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Button Content="Apply by Cmd" Grid.Row="0" Grid.Column="0" Margin="8"></Button>
            <Button Content="Apply by Act" Grid.Row="0" Grid.Column="1" Margin="8"></Button>
            <Button Content="Hide" Grid.Row="0" Grid.Column="2" Margin="8"></Button>

            <Image x:Name="pictureBox1" Grid.ColumnSpan="3" Grid.Row="1" Margin="10"/>
        </Grid -->

    </Grid>
</Window>
