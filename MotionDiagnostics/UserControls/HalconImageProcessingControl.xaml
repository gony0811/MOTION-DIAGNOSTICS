<UserControl x:Class="MotionDiagnostics.UserControls.HalconImageProcessingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ha="clr-namespace:HalconDotNet;assembly=HalconDotNet"
             xmlns:local="clr-namespace:MotionDiagnostics.UserControls"
             xmlns:vm="clr-namespace:MotionDiagnostics.UserControls.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <Thickness x:Key="ControlMargin">5 5 0 0</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ha:HSmartWindowControlWPF  x:Name="HalconSmartWindow" Margin="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" RenderTransformOrigin="0,0" MinWidth="100" MinHeight="100" Initialized="HalconSmartWindow_Initialized" ScrollViewer.VerticalScrollBarVisibility="Disabled" HMoveContent="False" MouseMove="HalconSmartWindow_MouseMove" />
    </Grid>
</UserControl>
