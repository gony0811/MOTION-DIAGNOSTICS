<UserControl x:Class="MotionDiagnostics.UserControls.MotionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MotionDiagnostics.UserControls"
             xmlns:conv="clr-namespace:MotionDiagnostics.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="400" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"></conv:InverseBoolConverter>
            <conv:BoolToBrushConverter x:Key="BoolToBrushConverter"></conv:BoolToBrushConverter>
            <conv:SelectedAxisToIntegerConverter x:Key="SelectedAxisToIntegerConverter"></conv:SelectedAxisToIntegerConverter>
            <conv:BoolToErrorBrushConverter x:Key="BoolToErrorBrushConverter"></conv:BoolToErrorBrushConverter>
            <conv:DoubleToStringConverter x:Key="DoubleToStringConverter"></conv:DoubleToStringConverter>
            <Thickness x:Key="ControlMargin">5 5 0 0</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Content="Select Axis" Grid.Row="0" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <ComboBox x:Name="ComboBox_AxisName" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" MinWidth="100" Margin="5" SelectedIndex="{Binding SelectedMotionAxis, Mode=TwoWay, Converter={StaticResource SelectedAxisToIntegerConverter}}" SelectionChanged="ComboBox_AxisName_SelectionChanged" HorizontalContentAlignment="Center"
          ItemsSource="{Binding MotionAxisList}">
        </ComboBox>

        <Label Content="Actual Position" Grid.Row="1" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <TextBox x:Name="TextBox_ActualPosition" Text="{Binding ActualPosition, StringFormat=F6}" IsReadOnly="True" Grid.Row="1" Grid.Column="1" Margin="{StaticResource ControlMargin}" TextAlignment="Center" MinWidth="100"></TextBox>
        <Label Content="mm" Grid.Row="1" Grid.Column="2" Margin="{StaticResource ControlMargin}"></Label>
        <Label Content="Command Position" Grid.Row="2" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <TextBox x:Name="TextBox_CommandPosition" Text="{Binding CommandPosition, StringFormat=F6}" IsReadOnly="True" Grid.Row="2" Grid.Column="1" Margin="{StaticResource ControlMargin}" TextAlignment="Center" MinWidth="100"></TextBox>
        <Label Content="mm" Grid.Row="2" Grid.Column="2" Margin="{StaticResource ControlMargin}"></Label>
        <!--250121_mh.yun-->
        <Label Content="Actual Velocity" Grid.Row="3" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <TextBox x:Name="TextBox_CurrentVelocity" Text="{Binding ActualVelocity, StringFormat=F6}" IsReadOnly="True" Grid.Row="3" Grid.Column="1" Margin="{StaticResource ControlMargin}" TextAlignment="Center" MinWidth="100"></TextBox>
        <Label Content="mm/s" Grid.Row="3" Grid.Column="2" Margin="{StaticResource ControlMargin}"></Label>

        <Label Content="Command Velocity" Grid.Row="4" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <TextBox x:Name="TextBox_CommandVelocity" Text="{Binding CommandVelocity, StringFormat=F6}" IsReadOnly="True" Grid.Row="4" Grid.Column="1" Margin="{StaticResource ControlMargin}" TextAlignment="Center" MinWidth="100"></TextBox>
        <Label Content="mm/s" Grid.Row="4" Grid.Column="2" Margin="{StaticResource ControlMargin}"></Label>

        <Label Content="Limit Sensor" Grid.Row="5" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <Button Foreground="White" Background="{Binding IsPlusLimitChecked, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="1" Grid.Row="5" Margin="{StaticResource ControlMargin}">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Button.Content>
        </Button>
        <Button FontWeight="Heavy"  Foreground="White" Background="{Binding IsMinusLimitChecked, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="2" Grid.Row="5" Margin="{StaticResource ControlMargin}">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="−" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Button.Content>
        </Button>

        <Label Content="Servo Status" Grid.Row="6" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <Button Content="ENABLE" FontSize="12" Foreground="White" Background="{Binding IsEnableChecked, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="1" Grid.Row="6" Margin="{StaticResource ControlMargin}"></Button>
        <Button Content="DISABLE" FontSize="12" Foreground="White" Background="{Binding IsDisableChecked, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="2" Grid.Row="6" Margin="{StaticResource ControlMargin}"></Button>

        <Label Content="Run Status" Grid.Row="7" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <Button Content="IN POSITION" FontSize="12" Foreground="White" Background="{Binding IsInPositionChecked, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="1" Grid.Row="7" Margin="{StaticResource ControlMargin}"></Button>
        <Button Content="BUSY" FontSize="12" Foreground="White" Background="{Binding IsBusyChecked, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="2" Grid.Row="7" Margin="{StaticResource ControlMargin}"></Button>

        <Label Content="Calibration Status" Grid.Row="8" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <Button Content="HOMMING" FontSize="12" Foreground="White" Background="{Binding IsHommingChecked, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="1" Grid.Row="8" Margin="{StaticResource ControlMargin}"></Button>
        <Button Content="HOME DONE" FontSize="12" Foreground="White" Background="{Binding IsCalibrationChecked, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="2" Grid.Row="8" Margin="{StaticResource ControlMargin}"></Button>

        <Label Content="Servo Error" Grid.Row="9" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>

        <Button Content="ERROR" FontSize="12" Foreground="White" Background="{Binding IsErrorChecked, Converter={StaticResource BoolToErrorBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="1" Grid.Row="9" Margin="{StaticResource ControlMargin}"></Button>

        <TextBlock TextAlignment="Center" FontSize="12" Grid.Column="2" Grid.Row="9" Text="{Binding ServoErrorText}" MinWidth="100" Margin="{StaticResource ControlMargin}"></TextBlock>
        <Border Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" BorderThickness="3" Margin="{StaticResource ControlMargin}"></Border>


        <Label Content="Servo Enable" Grid.Row="11" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <Button Content="Enable" MinWidth="100" Grid.Column="1" Grid.Row="11" Margin="{StaticResource ControlMargin}" Click="ButtonServoEnable_Click">
        </Button>
        <Button Content="Disable" MinWidth="100" Grid.Column="2" Grid.Row="11" Margin="{StaticResource ControlMargin}" Click="ButtonServoDisable_Click"></Button>

        <Label Content="Homming" Grid.Row="12" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <Button Content="Home" MinWidth="100" Grid.Column="1" Grid.Row="12" Margin="{StaticResource ControlMargin}" Click="ButtonHome_Click">
        </Button>
        <Button Content="Stop" MinWidth="100" Grid.Column="2" Grid.Row="12" Margin="{StaticResource ControlMargin}" Click="ButtonStop_Click"></Button>

        <Label Content="Jog" Grid.Row="13" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <Button MinWidth="100" Grid.Column="1" Grid.Row="13" Margin="{StaticResource ControlMargin}" PreviewMouseLeftButtonDown="ButtonJogMinus_MouseLeftButtonDown" PreviewMouseLeftButtonUp="Button_MouseLeftButtonUp">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25C0;" FontSize="16" VerticalAlignment="Center"/>

                </StackPanel>
            </Button.Content>
        </Button>
        <Button MinWidth="100" Grid.Column="2" Grid.Row="13" Margin="{StaticResource ControlMargin}" PreviewMouseLeftButtonDown="ButtonJogPlus_MouseLeftButtonDown" PreviewMouseLeftButtonUp="Button_MouseLeftButtonUp">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x25B6;" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </Button.Content>
        </Button>

        <Label Content="Velocity" Grid.Row="14" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <StackPanel Orientation="Horizontal"  Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <RadioButton x:Name="RadioButton_InputVelocity" Content="Input" GroupName="JogVelocity" MinWidth="70" Checked="RadioButton_VelocityChecked" IsChecked="{Binding IsInputVelocityChecked}" Margin="5,2">
                <RadioButton.ToolTip>
                    <TextBlock Text="Please write velocity below input box"></TextBlock>
                </RadioButton.ToolTip>
            </RadioButton>
            <RadioButton x:Name="RadioButton_LowVelocity" Content="Low" GroupName="JogVelocity" MinWidth="70" Checked="RadioButton_VelocityChecked"  IsChecked="{Binding IsLowVelocityChecked}" Margin="5,2">
                <RadioButton.ToolTip>
                    <TextBlock Text="10 mm/s"></TextBlock>
                </RadioButton.ToolTip>
            </RadioButton>
            <RadioButton x:Name="RadioButton_MidVelocity" Content="Mid" GroupName="JogVelocity" MinWidth="70" Checked="RadioButton_VelocityChecked"  IsChecked="{Binding IsMidVelocityChecked}" Margin="5,2">
                <RadioButton.ToolTip>
                    <TextBlock Text="50 mm/s"></TextBlock>
                </RadioButton.ToolTip>
            </RadioButton>
            <RadioButton x:Name="RadioButton_HighVelocity" Content="High" GroupName="JogVelocity" MinWidth="70" Checked="RadioButton_VelocityChecked" IsChecked="{Binding IsHighVelocityChecked}" Margin="5,2">
                <RadioButton.ToolTip>
                    <TextBlock Text="100 mm/s"></TextBlock>
                </RadioButton.ToolTip>
            </RadioButton>
        </StackPanel>

        <Label Content="User Input Velocity" Grid.Row="15" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <telerik:RadNumericUpDown x:Name="TextBox_UserInputVelocity" Grid.Row="15" Value="{Binding Path=InputVelocity, Mode=TwoWay }" ValueFormat="Numeric" NumberDecimalDigits="3"  ShowButtons="False" SmallChange="0.001"
                 Grid.Column="1" Margin="{StaticResource ControlMargin}" MinWidth="100"
                 PreviewTextInput="TextBox_UserInputVelocity_PreviewTextInput"/>
        <Button IsEnabled="{Binding IsInputVelocityChecked}" MinWidth="100" Grid.Column="2" Grid.Row="15" Margin="{StaticResource ControlMargin}" Click="ButtonUserInputVelocity_Click">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2699;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Set" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}"></TextBlock>
                </StackPanel>
            </Button.Content>
        </Button>

        <Label Content="Move Absolute" Grid.Row="16" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <telerik:RadNumericUpDown x:Name="TextBox_MoveAbsolute" Grid.Row="16" Value="{Binding MoveAbsPosition}" ValueFormat="Numeric" NumberDecimalDigits="3" ShowButtons="False" SmallChange="0.001"
                           Grid.Column="1" Margin="{StaticResource ControlMargin}" MinWidth="100"/>
        <Button MinWidth="100" Grid.Column="2" Grid.Row="16" Margin="{StaticResource ControlMargin}" Click="ButtonMoveAbs_Click">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2192;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Move ABS" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}"></TextBlock>
                </StackPanel>
            </Button.Content>
        </Button>

        <Label Content="Move Relative" Grid.Row="17" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <telerik:RadNumericUpDown x:Name="TextBox_MoveRelative" Grid.Row="17" Value="{Binding MoveRelDistance}" ValueFormat="Numeric" NumberDecimalDigits="3"  ShowButtons="False" SmallChange="0.001"
                           Grid.Column="1" Margin="{StaticResource ControlMargin}" MinWidth="100"/>
        <Button MinWidth="100" Grid.Column="2" Grid.Row="17" Margin="{StaticResource ControlMargin}" Click="ButtonMoveRel_Click">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2194;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Move REL" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}"></TextBlock>
                </StackPanel>
            </Button.Content>
        </Button>

        <Label Content="E-STOP" Grid.Row="18" Grid.Column="0" Margin="{StaticResource ControlMargin}"></Label>
        <Button MinWidth="100" Grid.Column="1" Grid.Row="18" Margin="{StaticResource ControlMargin}" Click="ButtonErrorReset_Click">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x21BB;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Error Reset" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}"></TextBlock>
                </StackPanel>
            </Button.Content>
        </Button>
        <Button MinWidth="100" Grid.Column="2" Grid.Row="18" Margin="{StaticResource ControlMargin}" Click="ButtonESTOP_Click">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x23F9;" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="E-STOP" VerticalAlignment="Center" Margin="{StaticResource ControlMargin}"></TextBlock>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</UserControl>
