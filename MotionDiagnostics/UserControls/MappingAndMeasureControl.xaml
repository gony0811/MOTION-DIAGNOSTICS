<UserControl x:Class="MotionDiagnostics.UserControls.MappingAndMeasureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <Thickness x:Key="ControlMargin">5 5 0 0</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" HorizontalContentAlignment="Center" Content="&#xB9E4;&#xD551; &#xBC0F; &#xCE21;&#xC815;" Margin="10" FontWeight="Bold"></Label>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>


            <Button Content="MEASURE" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="0" Command="{Binding MeasureCommand}"></Button>
            <Button Content="MAPPING" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="1" ></Button>
            <Button Content="STOP" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="2"></Button>

            <Label Grid.Column="3" Grid.ColumnSpan="5" Grid.Row="0" Content="&#xC591;&#xD488; &#xBD88;&#xB7C9; &#xC218;&#xB7C9;" HorizontalContentAlignment="Center" FontWeight="Bold"></Label>
            <Label IsHitTestVisible="False" Content="OK" HorizontalContentAlignment="Center" Grid.Column="2" Grid.Row="1" ></Label>
            <TextBox TextAlignment="Center" Grid.ColumnSpan="2" Grid.Column="3" Grid.Row="1" ></TextBox>
            <Label IsHitTestVisible="False" Content="NG" HorizontalContentAlignment="Center" Grid.Column="2" Grid.Row="2"></Label>
            <TextBox TextAlignment="Center" Grid.ColumnSpan="2" Grid.Column="3" Grid.Row="2" ></TextBox>

            <Label HorizontalContentAlignment="Center" Grid.ColumnSpan="6" Grid.Row="3" Content="&#xC790;&#xB3D9; &#xCE21;&#xC815; &#xACB0;&#xACFC; (um)" FontWeight="Bold"></Label>
            <Label IsHitTestVisible="False" Content="Min.X" FontSize="9" FontWeight="Bold" HorizontalContentAlignment="Center" Grid.Column="0" Grid.Row="5"></Label>
            <TextBox Name="MinX"  TextAlignment="Center" Grid.ColumnSpan="2" Grid.Column="1" Grid.Row="5"></TextBox>

            <Label IsHitTestVisible="False" Content="Max.X"  FontSize="9"  FontWeight="Bold" HorizontalContentAlignment="Center" Grid.Column="0" Grid.Row="4"></Label>
            <TextBox Name="MaxX"  TextAlignment="Center" Grid.ColumnSpan="2" Grid.Column="1" Grid.Row="4"></TextBox>

            <Label IsHitTestVisible="False" Content="Min.Y"  FontSize="9"  FontWeight="Bold" HorizontalContentAlignment="Center" Grid.Column="3" Grid.Row="6"></Label>
            <TextBox Name="MinY" TextAlignment="Center" Grid.ColumnSpan="2" Grid.Column="4" Grid.Row="5"></TextBox>

            <Label IsHitTestVisible="False" Content="Max.Y"  FontSize="9"  FontWeight="Bold" HorizontalContentAlignment="Center" Grid.Column="3" Grid.Row="4"></Label>
            <TextBox Name="MaxY" TextAlignment="Center" Grid.ColumnSpan="2" Grid.Column="4" Grid.Row="4"></TextBox>
        </Grid>
    </Grid>

</UserControl>
