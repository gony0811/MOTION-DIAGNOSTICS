<UserControl x:Class="MotionDiagnostics.UserControls.PositionStatusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converter="clr-namespace:MotionDiagnostics.Converters"
             mc:Ignorable="d"

             >
    <UserControl.Resources>
        <ResourceDictionary>
            <Thickness x:Key="ControlMargin">5 5 0 5</Thickness>
            <converter:BoolToBrushConverter x:Key="BoolToBrushConverter"></converter:BoolToBrushConverter>
            <Style TargetType="RadioButton">
                <Setter Property="Margin" Value="{StaticResource ControlMargin}"></Setter>
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="10,10,40,10"></Setter>
                <Setter Property="FontWeight" Value="Bold"></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Text="Command Position" Grid.Column="0" Grid.Row="0" Margin="{StaticResource ControlMargin}"></TextBlock>
        <TextBlock Text="{Binding PositionStatus.CommandPosition}" MinWidth="100" Grid.Column="1" Grid.Row="0" Margin="{StaticResource ControlMargin}"></TextBlock>
        <TextBlock Text="Feedback Position" Grid.Column="0" Grid.Row="1" Margin="{StaticResource ControlMargin}"> </TextBlock>
        <TextBlock Text="{Binding PositionStatus.FeedbackPosition}" MinWidth="100" Grid.Column="1" Grid.Row="1" Margin="{StaticResource ControlMargin}"></TextBlock>
        <TextBlock Text="Unit / Pulse" Grid.Column="0" Grid.Row="2" Margin="{StaticResource ControlMargin}"></TextBlock>
        <TextBlock Text="{Binding PositionStatus.UnitPulse}" MinWidth="100" Grid.Column="1" Grid.Row="2" Margin="{StaticResource ControlMargin}"></TextBlock>

        <Button Content="+Limit" Background="{Binding PositionStatus.PlusLimit, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="2" Grid.Row="0" Margin="{StaticResource ControlMargin}"></Button>
        <Button Content="-Limit" Background="{Binding PositionStatus.MinusLimit, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="3" Grid.Row="0" Margin="{StaticResource ControlMargin}"></Button>
        <Button Content="InPosition" Background="{Binding PositionStatus.InPosition, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="4" Grid.Row="0" Margin="{StaticResource ControlMargin}"></Button>
        <Button Content="Enable" Background="{Binding PositionStatus.Enable, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="2" Grid.Row="1" Margin="{StaticResource ControlMargin}"></Button>
        <Button Content="Busy" Background="{Binding PositionStatus.Busy, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="3" Grid.Row="1" Margin="{StaticResource ControlMargin}"></Button>
        <Button Content="Alarm" Background="{Binding PositionStatus.Alarm, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="4" Grid.Row="1" Margin="{StaticResource ControlMargin}"></Button>
        <Button Content="Home" Background="{Binding PositionStatus.HomeStat, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="2" Grid.Row="2" Margin="{StaticResource ControlMargin}"></Button>
        <Button Content="Home Done" Background="{Binding PositionStatus.HomeDone, Converter={StaticResource BoolToBrushConverter}}" MinWidth="100" IsHitTestVisible="False" Grid.Column="3" Grid.Row="2" Margin="{StaticResource ControlMargin}"></Button>
    </Grid>
</UserControl>
