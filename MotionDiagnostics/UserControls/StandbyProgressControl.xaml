<UserControl x:Class="MotionDiagnostics.UserControls.StandbyProgressControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MotionDiagnostics.UserControls"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:vm="clr-namespace:MotionDiagnostics.UserControls.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="1000">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Unloaded">
            <i:InvokeCommandAction Command="{Binding UnloadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources>
        <ResourceDictionary>
            <Thickness x:Key="ControlMargin">5 5 0 0</Thickness>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Margin="{StaticResource ControlMargin}" Height="50" MinWidth="100" Content="&#xC7A5;&#xCE58; &#xC5F0;&#xACB0;" FontSize="10" Foreground="White" Background="{Binding DeviceAttachStatusBackground}" IsHitTestVisible="False">
            </Button>
            <Button Grid.Column="1" Margin="{StaticResource ControlMargin}" Height="20" MinWidth="20" IsHitTestVisible="False" BorderThickness="0">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Grid.Column="2" Margin="{StaticResource ControlMargin}" Height="50" MinWidth="100" Content="&#xBAA8;&#xC158; &#xCD08;&#xAE30;&#xD654;" FontSize="10" Foreground="White" Background="{Binding MotionInitStatusBackground}" IsHitTestVisible="False">
            </Button>
            <Button Grid.Column="3" Margin="{StaticResource ControlMargin}" Height="20" MinWidth="20" IsHitTestVisible="False" BorderThickness="0">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Grid.Column="4" Margin="{StaticResource ControlMargin}" Height="50" MinWidth="100" Content="Wafer Loading" FontSize="10" Foreground="White" Background="{Binding WaferLoadingStatusBackground}" IsHitTestVisible="False" >
            </Button>
            <Button Grid.Column="5" Margin="{StaticResource ControlMargin}" Height="20" MinWidth="20" IsHitTestVisible="False" BorderThickness="0">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Grid.Column="6" Margin="{StaticResource ControlMargin}" Height="50" MinWidth="100" Content="VISION &#xC815;&#xBCF4; &#xB4F1;&#xB85D;" FontSize="10" Foreground="White" Background="{Binding VisionStatusBackground}" IsHitTestVisible="False">
            </Button>
            <Button Grid.Column="7" Margin="{StaticResource ControlMargin}" Height="20" MinWidth="20" IsHitTestVisible="False" BorderThickness="0">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Grid.Column="8" Margin="{StaticResource ControlMargin}" Height="50" MinWidth="100" Content="Wafer Align" FontSize="10" Foreground="White" Background="{Binding WaferAlignStatusBackground}" IsHitTestVisible="False">
            </Button>
            <Button Grid.Column="9" Margin="{StaticResource ControlMargin}" Height="20" MinWidth="20" IsHitTestVisible="False" BorderThickness="0">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6;" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button Grid.Column="10" Margin="{StaticResource ControlMargin}" Height="50" MinWidth="100" Content="STANDBY" FontSize="10" Foreground="White" Background="{Binding MeasureStandbyStatusBackground}" IsHitTestVisible="False">
            </Button>
        </Grid>

        <StatusBar x:Name="StandbyProcess_StatusBar" Grid.Row="1" FontSize="14" Margin="5">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentStepStatus}" FontWeight="Bold"></TextBlock>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="&#x25B6;" FontSize="10"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" FontWeight="Bold"></TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
