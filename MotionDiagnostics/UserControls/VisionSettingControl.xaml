<UserControl x:Class="MotionDiagnostics.UserControls.VisionSettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ha="clr-namespace:HalconDotNet;assembly=HalconDotNet"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:MotionDiagnostics.UserControls"
             xmlns:conv="clr-namespace:MotionDiagnostics.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources>
        <ResourceDictionary>
            <Thickness x:Key="ControlMargin">5 5 0 0</Thickness>
            <Style x:Key="LiveButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLiveOn}" Value="True">
                        <Setter Property="Background" Value="LightGreen"/>
                        <Setter Property="Foreground" Value="Black"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsLiveOn}" Value="False">
                        <Setter Property="Background" Value="LightGray"/>
                        <Setter Property="Foreground" Value="DarkGray"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- 모델 등록 검사 Button List -->
        <StackPanel Grid.Row="2" Grid.Column="0">
            <Button Style="{StaticResource LiveButtonStyle}" Content="Live" MinWidth="70" Margin="{StaticResource ControlMargin}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:InvokeCommandAction Command="{Binding LiveButtonClickCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <Button Content="Save" MinWidth="70" Margin="{StaticResource ControlMargin}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:InvokeCommandAction Command="{Binding SaveButtonClickCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <Button Content="Load" MinWidth="70" Margin="{StaticResource ControlMargin}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:InvokeCommandAction Command="{Binding LoadButtonClickCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <Button Content="Register" MinWidth="70" Margin="{StaticResource ControlMargin}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:InvokeCommandAction Command="{Binding RegisterButtonClickCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
            <Button Content="Find" MinWidth="70" Margin="{StaticResource ControlMargin}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                        <i:InvokeCommandAction Command="{Binding FindButtonClickCommand}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Button>
        </StackPanel>

        <!-- 이미지 -->
        <Border Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" BorderThickness="1" Height="180" Width="220" BorderBrush="#3498DB"  Margin="{StaticResource ControlMargin}">
            <Image Source="{Binding ImageSource}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Border>

        <!-- 오른쪽 Grid -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" >
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>


            <Label Content="&#xBE44;&#xC804; &#xCE21;&#xC815; &#xACB0;&#xACFC; (&#x339E;)" FontStyle="Oblique" Grid.ColumnSpan="4" Grid.Row="0" Margin="{StaticResource ControlMargin}" HorizontalAlignment="Left"></Label>
            <Label Content="X" Grid.Column="0" Grid.Row="1" Margin="{StaticResource ControlMargin}"></Label>
            <TextBox Text="{Binding VisionOffsetX, StringFormat={}{0:F6} mm}" Grid.Column="1" Grid.Row="1" MinWidth="70" Margin="{StaticResource ControlMargin}" IsReadOnly="True"></TextBox>
            <Label Content="Y" Grid.Column="2" Grid.Row="1" Margin="{StaticResource ControlMargin}"></Label>
            <TextBox Text="{Binding VisionOffsetY, StringFormat={}{0:F6} mm}" Grid.Column="3" Grid.Row="1" MinWidth="70" Margin="{StaticResource ControlMargin}" IsReadOnly="True"></TextBox>
        </Grid>
    </Grid>
</UserControl>
