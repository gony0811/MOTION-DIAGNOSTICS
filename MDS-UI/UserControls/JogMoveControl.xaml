<UserControl x:Class="MDS.UI.UserControls.JogMoveControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             >
    <UserControl.Resources>
        <ResourceDictionary>
            <Thickness x:Key="ControlMargin">5 5 0 0</Thickness>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"> </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button Grid.Row="1" Grid.Column="1" Margin="{StaticResource ControlMargin}" MinHeight="35" MinWidth="35"
                PreviewMouseDown="Button_JogUp_PreviewMouseDown"
                MouseDown="Button_JogUp_MouseDown">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x25B2;" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button Grid.Row="2" Grid.Column="1" Margin="{StaticResource ControlMargin}" MinHeight="35" MinWidth="35"
                PreviewMouseDown="Button_JogDown_PreviewMouseDown"
                MouseDown="Button_JogDown_MouseDown">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x25BC;" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Button Grid.Row="2" Grid.Column="0" Margin="{StaticResource ControlMargin}" MinHeight="35" MinWidth="35"
                PreviewMouseDown="Button_JogLeft_PreviewMouseDown"
                MouseDown="Button_JogLeft_MouseDown">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x25C0;" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
        <Button x:Name="Button_JogRight" Grid.Row="2" Grid.Column="2" Margin="{StaticResource ControlMargin}" MinHeight="35" MinWidth="35"
                PreviewMouseDown="Button_JogRight_PreviewMouseDown"
                MouseDown="Button_JogRight_MouseDown">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x25B6;" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" BorderThickness="1">

        </Border>

        <Button Grid.Row="1" Grid.Column="4" Margin="{StaticResource ControlMargin}" MinHeight="35" MinWidth="35"
                PreviewMouseDown="Button_JogZUp_PreviewMouseDown"
                MouseDown="Button_JogZUp_MouseDown">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x25B3;" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Button Grid.Row="2" Grid.Column="4" Margin="{StaticResource ControlMargin}" MinHeight="35" MinWidth="35"
                PreviewMouseDown="Button_JogZDown_PreviewMouseDown"
                MouseDown="Button_JogZDown_MouseDown">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x25BD;" FontSize="16" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="{StaticResource ControlMargin}" Click="Button_JogSettings_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x25CF;" FontSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="Settings"/>
            </StackPanel>
        </Button>
    </Grid>

</UserControl>
